{
  "version": 2,
  "buildCommand": "cd frontend && npm install && npm run build",
  "outputDirectory": "frontend/dist",
  "installCommand": "cd frontend && npm install",
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!api|assets|\\.well-known).*)", "destination": "/index.html" }
  ],
  "headers": [
    {
      "source": "/.well-known/assetlinks.json",
      "headers": [
        { "key": "Content-Type", "value": "application/json" },
        { "key": "Access-Control-Allow-Origin", "value": "*" }
      ]
    },
    {
      "source": "/api/(.*)",
      "headers": [
        { "key": "Access-Control-Allow-Origin", "value": "*" },
        { "key": "Access-Control-Allow-Methods", "value": "GET,POST,OPTIONS" },
        { "key": "Access-Control-Allow-Headers", "value": "Content-Type,Authorization" }
      ]
    }
  ],
  "functions": {
    "api/whatsapp.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 60
    },
    "api/sms/process.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 30
    },
    "api/cron/morning-brief.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 60
    },
    "api/cron/check-reminders.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 30
    },
    "api/cron/medicine-alert.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 30
    },
    "api/cron/weekly-summary.py": {
      "runtime": "@vercel/python@4.5.0",
      "maxDuration": 60
    }
  },
  "crons": [
    {
      "path": "/api/cron/morning-brief",
      "schedule": "30 1 * * *"
    },
    {
      "path": "/api/cron/check-reminders",
      "schedule": "0 8 * * *"
    },
    {
      "path": "/api/cron/medicine-alert",
      "schedule": "0 * * * *"
    },
    {
      "path": "/api/cron/weekly-summary",
      "schedule": "30 14 * * 0"
    }
  ]
}
